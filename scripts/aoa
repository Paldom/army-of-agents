#!/usr/bin/env bash
# Run the fleet for ONE project. Usage: aoa <command> [project-dir]
#
# This script lives in the skill; nothing about a project does. A fleet's
# store, config and worktrees all live beside the project it works on, so one
# checkout of the skill drives any number of projects, upgrading the skill
# cannot delete a fleet's memory, and the skill directory stays generic.
#
#   <project>-agents/aoa.env     config for this project
#   <project>-agents/aoa.db      this fleet's store
#   <project>-agents/<slug>/     each agent's worktree
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CMD="${1:-help}"
PROJECT="${2:-${AOA_PROJECT_ROOT:-}}"

if [[ -z "$PROJECT" ]]; then
  echo "which project? usage: $0 $CMD /path/to/project" >&2
  echo "  (or export AOA_PROJECT_ROOT)" >&2
  exit 2
fi
[[ -d "$PROJECT" ]] || { echo "no such directory: $PROJECT" >&2; exit 2; }
PROJECT="$(cd "$PROJECT" && pwd)"

# Beside the project, matching where the worktrees already go.
STATE="${AOA_STATE_DIR:-$(dirname "$PROJECT")/$(basename "$PROJECT")-agents}"
ENV_FILE="$STATE/aoa.env"
NS="$(basename "$PROJECT" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9\n' '-' | sed 's/^-*//;s/-*$//' | cut -c1-24)"
SESSION="aoa-${NS:-project}"

mkdir -p "$STATE"
if [[ -f "$ENV_FILE" ]]; then set -a; . "$ENV_FILE"; set +a; fi

: "${AOA_PORT:=8800}"
: "${AOA_TICK_MS:=15000}"
: "${AOA_MAX_IN_FLIGHT:=6}"
AOA_PROJECT_ROOT="$PROJECT"
AOA_STATE_DIR="$STATE"
: "${AOA_DB:=$STATE/aoa.db}"

if [[ -z "${AOA_TOKEN:-}" ]]; then
  # A local bearer token for the workspace, not a vendor credential. Generated
  # once and kept, so the URL you bookmark keeps working across restarts.
  AOA_TOKEN="$(openssl rand -hex 24)"
  printf '# generated by aoa on first start\nAOA_TOKEN=%s\n' "$AOA_TOKEN" >> "$ENV_FILE"
  chmod 600 "$ENV_FILE"
  echo "wrote a new AOA_TOKEN to $ENV_FILE"
fi

# tmux windows inherit the tmux SERVER's environment, not this shell's, and the
# server is usually already up for the agent terminals. Passing these
# explicitly is the difference between the configured port and a silent default.
env_args=()
for v in AOA_PROJECT_ROOT AOA_STATE_DIR AOA_DB AOA_PORT AOA_TICK_MS AOA_MAX_IN_FLIGHT \
         AOA_TOKEN AOA_NAMESPACE ELEVENLABS_API_KEY ELEVENLABS_AGENT_ID; do
  [[ -n "${!v:-}" ]] && env_args+=(-e "$v=${!v}")
done
run() { echo "cd '$ROOT/app' && exec node --experimental-strip-types $1"; }

case "$CMD" in
  up)
    tmux has-session -t "$SESSION" 2>/dev/null && { echo "already up for $PROJECT"; exit 0; }
    if lsof -nP -iTCP:"$AOA_PORT" -sTCP:LISTEN >/dev/null 2>&1; then
      echo "port $AOA_PORT is already in use — set AOA_PORT in $ENV_FILE" >&2; exit 1
    fi
    tmux new-session -d -s "$SESSION" -n workspace "${env_args[@]}" "$(run src/server/main.ts)"
    tmux new-window -t "$SESSION" -n loop "${env_args[@]}" "$(run src/supervisor/main.ts)"
    sleep 2
    tmux has-session -t "$SESSION" 2>/dev/null || { echo "failed to start" >&2; exit 1; }
    echo "up:      http://127.0.0.1:$AOA_PORT/?token=$AOA_TOKEN"
    echo "project: $PROJECT"
    echo "state:   $STATE"
    echo "watch:   $0 attach $PROJECT     stop: $0 down $PROJECT"
    ;;
  down)
    # Only this project's loop and workspace. Agent sessions are left running
    # on purpose: a turn in flight is finished and reconciled on the next
    # start, not destroyed because the loop restarted.
    tmux kill-session -t "$SESSION" 2>/dev/null \
      && echo "stopped $NS (agent terminals left running)" || echo "not running"
    ;;
  restart) "$0" down "$PROJECT"; sleep 1; "$0" up "$PROJECT" ;;
  attach)  exec tmux attach -t "$SESSION" ;;
  logs)    tmux capture-pane -p -S -200 -t "$SESSION:loop" ;;
  doctor)
    # What is installed and configured, from the running workspace's own checks.
    curl -sf -H "authorization: Bearer $AOA_TOKEN" "http://127.0.0.1:$AOA_PORT/api/doctor" \
      | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{for(const c of JSON.parse(s).checks)console.log(`${c.ok?"ok     ":c.optional?"off    ":"MISSING"} ${c.id.padEnd(18)} ${c.detail}`)})' \
      || { echo "workspace not answering on $AOA_PORT; is it up?" >&2; exit 1; }
    ;;
  status)
    tmux has-session -t "$SESSION" 2>/dev/null && echo "loop+workspace: up" || echo "loop+workspace: down"
    curl -sf -o /dev/null -H "authorization: Bearer $AOA_TOKEN" "http://127.0.0.1:$AOA_PORT/api/state" \
      && echo "api: answering on $AOA_PORT" || echo "api: not answering on $AOA_PORT"
    echo "store: $AOA_DB"
    echo "agent terminals: $(tmux list-sessions -F '#{session_name}' 2>/dev/null | grep -c "^$NS-" || true)"
    ;;
  *) echo "usage: $0 {up|down|restart|attach|logs|status|doctor} [project-dir]" >&2; exit 2 ;;
esac
