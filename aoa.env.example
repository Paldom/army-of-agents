# Per-PROJECT config. This file belongs beside the project it configures:
#
#     <project>-agents/aoa.env
#
# not in the skill directory. `aoa up /path/to/project` creates it and writes a
# token on first start, so usually you never touch this by hand.

# Optional; sensible defaults are derived from the project path.
# AOA_PORT=8800                 one per project if you run several
# AOA_TICK_MS=15000
# Turns in flight at once. Each is a live vendor session, so this is the quota
# control, not a performance knob.
# AOA_MAX_IN_FLIGHT=6
# AOA_STATE_DIR=<project>-agents     store, config and worktrees
# AOA_DB=<state>/aoa.db
# AOA_NAMESPACE=<project-basename>   prefixes tmux session names
# Voice. Without these the browser's own speech API is used instead.
# ELEVENLABS_API_KEY=
# ELEVENLABS_AGENT_ID=
