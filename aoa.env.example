# Per-PROJECT config. This file belongs beside the project it configures:
#
#     <project>-agents/aoa.env
#
# not in the skill directory. `aoa up /path/to/project` creates it and writes a
# token on first start, so usually you never touch this by hand.

# Optional; sensible defaults are derived from the project path.
# AOA_PORT=8800                 one per project if you run several
# AOA_TICK_MS=15000
# Turns in flight at once. Each is a live vendor session, so this is the quota
# control, not a performance knob.
# AOA_MAX_IN_FLIGHT=6
# AOA_STATE_DIR=<project>-agents     store, config and worktrees
# AOA_DB=<state>/aoa.db
# AOA_NAMESPACE=<project-basename>   prefixes tmux session names
# Voice. Without these the browser's own speech API is used instead.
# ELEVENLABS_API_KEY=
# ELEVENLABS_AGENT_ID=
# Which harness the orchestrator runs on, for a fresh store (default claude).
# Changing it later is reported by the Doctor, not applied.
# AOA_ORCHESTRATOR_HARNESS=claude
# Outbound seam: a shell command that receives one JSON event on stdin.
# Wire it to a push, an e-mail, or `aconn notify` (agents-connect).
# AOA_EVENT_HOOK=aconn notify --stdin
# AOA_EVENT_HOOK_KINDS=ask.opened,ask.expired,agent.notify,alarm.lost_wake,lane.gated,plan.proposed
# A DevTools endpoint for the Browser tab, when the identity does not publish one;
# AOA_BROWSER_CDP_<SLUG> (dashes as underscores) for one agent.
# AOA_BROWSER_CDP=127.0.0.1:9222
# The browser-facing origin when a TLS terminator sits in front (else refused
# as cross-origin).
# AOA_PUBLIC_ORIGIN=https://fleet.example.com
# Extra or corrected harness rows; default <state>/harnesses.json.
# AOA_HARNESSES_FILE=<state>/harnesses.json
# The acpx binary, when it is not the one on PATH. Used by the loop, the pane
# and the doctor alike.
# AOA_ACPX_BIN=/usr/local/bin/acpx
